{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make vet)",
      "Bash(make test)",
      "Bash(make mod-check)",
      "Bash(make fuzz)",
      "Bash(make docs-build)",
      "Bash(make docs-check)",
      "Bash(make workflows-check)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(**/config.local.yaml)"
    ]
  }
}
